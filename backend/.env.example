# Server Port
PORT=4173

# Admin Secret Key (used for write access to products, viewing orders and subscribers)
ADMIN_KEY=replace-with-a-secure-random-key

# Allowed CORS Origins (comma-separated for production domains)
# In development, localhost and 127.0.0.1 on any port (5173, 5174, 5175, etc.) are allowed automatically.
# ALLOWED_ORIGINS=https://yourproductiondomain.co
# Cloudinary Configuration (Uncomment and configure to store images in Cloudinary)
# You can provide either CLOUDINARY_URL or the 3 individual credentials:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
